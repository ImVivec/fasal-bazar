# MongoDB Atlas connection string (server-only; never exposed to the browser)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Database name (default: fasal_bazar)
MONGODB_DB=fasal_bazar

# Shared secret for /api/ingest. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-to-a-long-random-string

# Signs login session cookies. 32+ random characters, e.g. `openssl rand -base64 32`. Changing it logs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string-32chars