{
  "name": "fasal-bazar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db-setup.ts",
    "gen:master": "tsx scripts/gen-master.ts",
    "backfill": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/backfill.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-admin.ts",
    "daily": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/daily.ts",
    "convert": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/convert-days.ts",
    "recompute:monthly": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/recompute-monthly.ts"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
